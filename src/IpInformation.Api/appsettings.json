{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ip2c": {
    "BaseAddress": "https://ip2c.org/",
    "Timeout": "00:00:10"
  },
  "IpAddressRefresh": {
    "Interval": "01:00:00",
    "BatchSize": 100
  }
}
